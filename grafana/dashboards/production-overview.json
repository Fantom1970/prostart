          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH tl AS (\n  SELECT generate_series(to_timestamp($__unixEpochFrom()), to_timestamp($__unixEpochTo()), interval '1 minute') AS bucket\n),\nordered AS (\n  SELECT sta_id, sta_bgn, LEAD(sta_bgn) OVER (ORDER BY sta_bgn) AS ns\n  FROM status WHERE un_id = 801 AND ent_id = 1\n),\niv AS (SELECT bucket, bucket + interval '1 minute' AS be FROM tl),\npb AS (\n  SELECT i.bucket AS time,\n    SUM(CASE WHEN e.sta_id = 6 THEN\n      EXTRACT(EPOCH FROM (LEAST(i.be, COALESCE(e.ns, i.be)) - GREATEST(i.bucket, e.sta_bgn)))\n    ELSE 0 END) AS sec\n  FROM iv i LEFT JOIN ordered e ON e.sta_bgn < i.be AND COALESCE(e.ns, i.be) > i.bucket\n  GROUP BY i.bucket\n),\npc AS (SELECT time, sec / 3600 * ${taxa_producao} AS produced FROM pb)\nSELECT time, SUM(produced) OVER (ORDER BY time) AS producao_acumulada FROM pc ORDER BY time",
          "refId": "A"
        }
      ],
      "title": "Accumulated",
      "type": "timeseries"
    },
