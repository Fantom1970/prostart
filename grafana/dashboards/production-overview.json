          "rawSql": "WITH ordered AS (\n  SELECT sta_id, sta_bgn, LEAD(sta_bgn) OVER (ORDER BY sta_bgn) AS ns\n  FROM status WHERE un_id = 801 AND ent_id = 1\n),\nclipped AS (\n  SELECT sta_id, GREATEST(sta_bgn, to_timestamp($__unixEpochFrom())) AS sc,\n    LEAST(COALESCE(ns, to_timestamp($__unixEpochTo())), to_timestamp($__unixEpochTo())) AS ec\n  FROM ordered WHERE sta_bgn < to_timestamp($__unixEpochTo())\n    AND COALESCE(ns, to_timestamp($__unixEpochTo())) > to_timestamp($__unixEpochFrom())\n),\nd AS (SELECT sta_id, EXTRACT(EPOCH FROM (ec - sc)) AS ds FROM clipped)\nSELECT ${taxa_producao} * SUM(CASE WHEN sta_id = 6 THEN ds ELSE 0 END) / ($__unixEpochTo() - $__unixEpochFrom()) AS taxa_media_emb_h\nFROM d",
