          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH c AS (\n  SELECT s.sta_bgn AS ic, MIN(f.sta_end) AS fc\n  FROM status s LEFT JOIN status f\n    ON f.sta_bgn > s.sta_bgn AND f.sta_id = 6 AND f.un_id = s.un_id AND f.ent_id = s.ent_id\n  WHERE s.sta_id = 4 AND s.un_id = 801 AND s.ent_id = 1 AND s.sta_bgn <= $__timeTo()\n  GROUP BY s.sta_bgn\n)\nSELECT AVG(EXTRACT(EPOCH FROM (fc - ic))/60) AS duracao_media_minutos FROM c WHERE ic >= $__timeFrom()",
          "refId": "A"
        }
      ],
      "title": "Cycles (avg duration)",
