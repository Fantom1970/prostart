          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH ordered AS (\n  SELECT sta_id, sta_bgn,\n    LEAD(sta_bgn) OVER (ORDER BY sta_bgn) AS next_start\n  FROM status WHERE un_id = 801 AND ent_id = 1\n),\nclipped AS (\n  SELECT sta_id,\n    GREATEST(sta_bgn, $__timeFrom()) AS start_clip,\n    LEAST(COALESCE(next_start, $__timeTo()), $__timeTo()) AS end_clip\n  FROM ordered\n  WHERE sta_bgn < $__timeTo() AND COALESCE(next_start, $__timeTo()) > $__timeFrom()\n),\ndurations AS (\n  SELECT sta_id, EXTRACT(EPOCH FROM (end_clip - start_clip)) AS ds FROM clipped\n)\nSELECT\n  SUM(CASE WHEN sta_id = 6 THEN ds ELSE 0 END)/3600 AS \"Produ\u00e7\u00e3o (h)\",\n  SUM(CASE WHEN sta_id = 4 THEN ds ELSE 0 END)/3600 AS \"Esteriliza\u00e7\u00e3o (h)\",\n  SUM(CASE WHEN sta_id = 1 THEN ds ELSE 0 END)/3600 AS \"CIP (h)\",\n  SUM(CASE WHEN sta_id = 0 THEN ds ELSE 0 END)/3600 AS \"Sem Produ\u00e7\u00e3o (h)\",\n  SUM(CASE WHEN sta_id = 5 THEN ds ELSE 0 END)/3600 AS \"Pronto/Setup (h)\",\n  SUM(CASE WHEN sta_id = 12 THEN ds ELSE 0 END)/3600 AS \"Manuten\u00e7\u00e3o (h)\",\n  SUM(ds)/3600 AS \"Total (h)\",\n  (SUM(CASE WHEN sta_id = 6 THEN ds ELSE 0 END) / SUM(ds)) * 100 AS \"OEE (%)\"\nFROM durations",
          "refId": "A"
        }
      ],
      "title": "Steps",
      "transformations": [
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "names": [
                "Produ\u00e7\u00e3o (h)",
                "Esteriliza\u00e7\u00e3o (h)",
                "CIP (h)",
                "Sem Produ\u00e7\u00e3o (h)",
                "Pronto/Setup (h)",
                "Manuten\u00e7\u00e3o (h)",
                "Total (h)",
                "OEE (%)"
              ]
            }
          }
        }
      ],
      "type": "bargauge"
