          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT \r\n  sta_bgn AS \"time\",\r\n  COALESCE(sta_end, NOW()) AS \"time_end\",\r\n  sta_id AS \"state\"\r\nFROM status \r\nWHERE un_id = 801 AND ent_id = 1\r\n  AND sta_bgn >= $__timeFrom()\r\n  AND sta_bgn <= $__timeTo()\r\nORDER BY sta_bgn",
          "refId": "A",
