      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "PE02C6D58FFD076CD"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH ordered AS (\n  SELECT sta_id, sta_bgn, LEAD(sta_bgn) OVER (ORDER BY sta_bgn) AS ns\n  FROM status WHERE un_id = 801 AND ent_id = 1\n),\nclipped AS (\n  SELECT sta_id, GREATEST(sta_bgn, $__timeFrom()) AS sc,\n    LEAST(COALESCE(ns, sta_bgn), $__timeTo()) AS ec\n  FROM ordered WHERE sta_bgn < $__timeTo() AND COALESCE(ns, sta_bgn) > $__timeFrom()\n),\ndur AS (\n  SELECT sta_id, EXTRACT(EPOCH FROM (ec - sc)) AS ds FROM clipped\n)\nSELECT\n  SUM(CASE WHEN sta_id = 6 THEN ds ELSE 0 END)/3600 AS \"Producao\",\n  SUM(CASE WHEN sta_id = 4 THEN ds ELSE 0 END)/3600 AS \"Esterilizacao\",\n  SUM(CASE WHEN sta_id = 1 THEN ds ELSE 0 END)/3600 AS \"CIP\",\n  SUM(CASE WHEN sta_id = 0 THEN ds ELSE 0 END)/3600 AS \"Sem Producao\",\n  SUM(CASE WHEN sta_id = 5 THEN ds ELSE 0 END)/3600 AS \"Setup\",\n  SUM(CASE WHEN sta_id = 12 THEN ds ELSE 0 END)/3600 AS \"Manutencao\"",
          "refId": "A"
        }
      ],
      "title": "Distribution",
      "type": "piechart"
