          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\r\n  s.sta_bgn AS \"time\",\r\n  LEAST(COALESCE(s.sta_end, NOW()), $__timeTo()) AS \"time_end\",\r\n  s.sta_id AS \"state\",\r\n  u.un_nam AS \"unit\",\r\n  CASE u.un_id\r\n    WHEN 600  THEN 1\r\n    WHEN 700  THEN 2\r\n    WHEN 803  THEN 3\r\n    WHEN 6100 THEN 4\r\n    WHEN 903  THEN 5\r\n    WHEN 913  THEN 6\r\n    WHEN 923  THEN 7\r\n    WHEN 933  THEN 8\r\n    WHEN 943  THEN 9\r\n  END AS \"sort_order\"\r\nFROM status s\r\nJOIN units u ON s.un_id = u.un_id\r\nWHERE s.ent_id = 1\r\n  AND s.un_id IN (600, 700, 803, 6100, 903, 913, 923, 933, 943)\r\n  AND s.sta_bgn >= $__timeFrom()\r\n  AND s.sta_bgn <= $__timeTo()\r\n\r\nUNION ALL\r\n\r\nSELECT\r\n  $__timeFrom() AS \"time\",\r\n  LEAST(COALESCE(s.sta_end, NOW()), $__timeTo()) AS \"time_end\",\r\n  s.sta_id AS \"state\",\r\n  u.un_nam AS \"unit\",\r\n  CASE u.un_id\r\n    WHEN 600  THEN 1\r\n    WHEN 700  THEN 2\r\n    WHEN 803  THEN 3\r\n    WHEN 6100 THEN 4\r\n    WHEN 903  THEN 5\r\n    WHEN 913  THEN 6\r\n    WHEN 923  THEN 7\r\n    WHEN 933  THEN 8\r\n    WHEN 943  THEN 9\r\n  END AS \"sort_order\"\r\nFROM status s\r\nJOIN units u ON s.un_id = u.un_id\r\nWHERE s.ent_id = 1\r\n  AND s.un_id IN (600, 700, 803, 6100, 903, 913, 923, 933, 943)\r\n  AND s.sta_bgn < $__timeFrom()\r\n  AND (s.sta_end IS NULL OR s.sta_end > $__timeFrom())\r\nORDER BY sort_order, \"time\"",
          "refId": "A",
