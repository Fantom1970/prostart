          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT s.sta_bgn AS time, COALESCE(s.sta_end, NOW()) AS time_end, s.sta_id AS state, u.un_nam AS unit, CASE u.un_id WHEN 610 THEN 1 WHEN 620 THEN 2 WHEN 802 THEN 3 WHEN 6000 THEN 4 WHEN 902 THEN 5 WHEN 912 THEN 6 WHEN 922 THEN 7 WHEN 932 THEN 8 WHEN 942 THEN 9 END AS sort_order FROM status s JOIN units u ON s.un_id = u.un_id WHERE s.ent_id = 1 AND s.un_id IN (610, 620, 802, 6000, 902, 912, 922, 932, 942) AND s.sta_bgn >= $__timeFrom() AND s.sta_bgn <= $__timeTo() ORDER BY sort_order, s.sta_bgn",
