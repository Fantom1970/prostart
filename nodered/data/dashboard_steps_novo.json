          "rawQuery": true,
          "rawSql": "WITH ordered AS (\n  SELECT sta_id, sta_bgn, LEAD(sta_bgn) OVER (ORDER BY sta_bgn) AS ns\n  FROM status WHERE un_id = 801 AND ent_id = 1\n),\nclipped AS (\n  SELECT sta_id, GREATEST(sta_bgn, $__timeFrom()) AS sc,\n    LEAST(COALESCE(ns, $__timeTo()), $__timeTo()) AS ec\n  FROM ordered WHERE sta_bgn < $__timeTo() AND COALESCE(ns, $__timeTo()) > $__timeFrom()\n),\nd AS (SELECT sta_id, EXTRACT(EPOCH FROM (ec - sc)) AS ds FROM clipped)\nSELECT (SUM(CASE WHEN sta_id = 6 THEN ds ELSE 0 END) / SUM(ds)) * 100 AS oee_percent\nFROM d",
