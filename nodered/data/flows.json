d) {\n    flow.set(\"previousStatus_\" + unitId, currentStatus);\n    return {\n        query: `INSERT INTO process_events (ENT_ID, UN_ID, STA_ID, STA_BGN) VALUES ($1, $2, $3, $4)`,\n        params: [enterpriseId, unitId, currentStatus, now]\n    };\n}\n\n// ===== SE NÃO MUDOU =====\nif (currentStatus === previousStatus) {\n    return null;\n}\n\n// ===== SE MUDOU =====\nflow.set(\"previousStatus_\" + unitId, currentStatus);\n\n// Fecha evento anterior\nlet updateMsg = {\n    query: `UPDATE process_events SET STA_END = $1 WHERE UN_ID = $2 AND ENT_ID = $3 AND STA_END IS NULL`,\n    params: [now, unitId, enterpriseId]\n};\n\n// Insere novo evento\nlet insertMsg = {\n    query: `INSERT INTO process_events (ENT_ID, UN_ID, STA_ID, STA_BGN) VALUES ($1, $2, $3, $4)`,\n    params: [enterpriseId, unitId, currentStatus, now]\n};\n\n// Envia as duas queries pela mesma saída\nreturn [[updateMsg, insertMsg]];","outputs":1,"timeout":0,"noerr":0,"initialize":"","finalize":"","libs":[],"x":520,"y":460,"wires":[["a54b1cf5aef772c3","69096ccaa160dc7e"]]},{"id":"478fb06f56f805cd","type":"mqtt in","z":"f02a34656bdf5f6b","name":"","topic":"Status","qos":"1","datatype":"auto-detect","broker":"2111b3674201f14b","nl":false,"rap":true,"rh":0,"inputs":0,"x":330,"y":460,"wires":[["bc41fb9f946af1d7","620ca4024b9d0088"]]},{"id":"29b4d2080fa6befc","type":"debug","z":"f02a34656bdf5f6b","name":"debug 1","active":true,"tosidebar":true,"console":false,"tostatus":false,"complete":"payload","targetType":"msg","statusVal":"","statusType":"auto","x":520,"y":260,"wires":[]},{"id":"620ca4024b9d0088","type":"debug","z":"f02a34656bdf5f6b","name":"debug 2","active":true,"tosidebar":true,"console":false,"tostatus":false,"complete":"false","statusVal":"","statusType":"auto","x":550,"y":560,"wires":[]},{"id":"a54b1cf5aef772c3","type":"debug","z":"f02a34656bdf5f6b","name":"debug 3","active":true,"tosidebar":true,"console":false,"tostatus":false,"complete":"true","targetType":"full","statusVal":"","statusType":"au