    {
        "id": "388b446485522f5b",
        "type": "function",
        "z": "860704c4ec7616df",
        "name": "function 1",
        "func": "// ===== CONFIGURAÇÃO =====\nlet clientId = 1;                  \nlet clientName = \"BONOLAT\";   // NOVO\nlet equipmentName = \"TA DRINK\";      \n// =========================\n\nlet previousStep = flow.get(\"previousStep\");\nlet currentStep = Number(msg.payload);\nlet now = new Date();\n\n// ===== PRIMEIRA EXECUÇÃO =====\nif (previousStep === undefined) {\n    flow.set(\"previousStep\", currentStep);\n\n    return {\n        query: `\n            INSERT INTO process_events\n            (client_id, client_name, equipment, step, start_time)\n            VALUES ($1, $2, $3, $4, $5)\n        `,\n        params: [clientId, clientName, equipmentName, currentStep, now]\n    };\n}\n\n// ===== SE NÃO MUDOU =====\nif (currentStep === previousStep) {\n    return null;\n}\n\n// ===== SE MUDOU =====\nflow.set(\"previousStep\", currentStep);\n\n// Fecha evento anterior\nlet updateMsg = {\n    query: `\n        UPDATE process_events\n        SET end_time = $1\n        WHERE equipment = $2\n        AND client_id = $3\n        AND end_time IS NULL\n    `,\n    params: [now, equipmentName, clientId]\n};\n\n// Insere novo evento\nlet insertMsg = {\n    query: `\n        INSERT INTO process_events\n        (client_id, client_name, equipment, step, start_time)\n        VALUES ($1, $2, $3, $4, $5)\n    `,\n    params: [clientId, clientName, equipmentName, currentStep, now]\n};\n\n// Envia as duas queries pela mesma saída\nreturn [[updateMsg, insertMsg]];",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 520,
        "y": 540,
        "wires": [
