    {
        "id": "5f4c8d7fd6c6a566",
        "type": "function",
        "z": "860704c4ec7616df",
        "name": "function 3",
        "func": "// Inicialização segura\nif (flow.get(\"step\") === undefined) {\n    flow.set(\"step\", 1);\n    flow.set(\"tick\", 0);\n}\n\nlet step = flow.get(\"step\");\nlet tick = flow.get(\"tick\");\n\n// Incrementa tick (1 tick = 1 segundo real)\ntick++;\n\n// Tempo em SEGUNDOS reais\nfunction residence(step) {\n\n    if (step === 27) return 36000;  // 10 horas\n    if (step === 0) return 7200;    // 2 horas parado\n    if (step === 6) return 1800;    // 30 min\n    if (step === 106 || step === 126) return 1800;\n\n    if ((step >= 1 && step <= 71) ||\n        (step >= 101 && step <= 197)) {\n        return 60; // 1 minuto\n    }\n\n    return 60;\n}\n\nlet residenceTime = residence(step);\n\n// Avança quando atingir o tempo real\nif (tick >= residenceTime) {\n\n    step++;\n\n    if (step > 197) {\n        step = 0;\n    }\n\n    if (step >= 72 && step <= 100) {\n        step = 101;\n    }\n\n    tick = 0;\n}\n\n// Salva estado\nflow.set(\"step\", step);\nflow.set(\"tick\", tick);\n\nmsg.payload = step;\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 300,
        "y": 240,
        "wires": [
            [
                "cd249805867226ef",
                "d965f35c34acdee0"
            ]
        ]
